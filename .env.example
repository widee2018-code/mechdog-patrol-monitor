# 복사해서 사용: cp .env.example .env   (.env 는 커밋되지 않는다)

# 로봇견 카메라 실시간 스트림. 여러 대면 쉼표로: A=http://...,B=http://...
CAMERAS=

# 외부 공개 시 필수. HTTP POST /api/ingest 에 필요한 토큰 (camera_relay.py --token 에도 같은 값)
# 만들기: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
INGEST_TOKEN=

# 고정 공개 주소용 Cloudflare 터널 토큰 (--profile tunnel 일 때만)
CF_TUNNEL_TOKEN=
