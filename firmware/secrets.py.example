# firmware/secrets.py.example 을 secrets.py 로 복사해서 쓴다. .gitignore에 들어 있어 커밋되지 않는다.
# Thonny에서 이 파일을 로봇견 안에 secrets.py 로 저장해 두면 dog_cmd.py, dog_status.py가 읽는다.
WIFI_SSID = "YOUR_WIFI"   # 2.4 GHz 네트워크만 가능
WIFI_PASS = "YOUR_PASSWORD"
MONITOR = ("192.168.0.11", 9000)   # server/app.py를 실행하는 노트북 IP (macOS: ipconfig getifaddr en0)
NAME = "B"                          # 이 로봇견의 이름: A, B 또는 C (개마다 바꿔서 저장)
