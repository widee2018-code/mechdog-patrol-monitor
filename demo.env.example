# 시연용 주소 모음. 복사해서 demo.env 로 쓰고(git 에 안 올라감), IP 가 바뀌면 이 파일만 고친다.
#     cp demo.env.example demo.env        (Windows: copy demo.env.example demo.env)
# 그다음 명령은 항상 같다:
#     python tools/demo.py check     IP 마다 응답 확인
#     python tools/demo.py hub       허브 (CAMERAS 는 아래 CAM_* 로 만듦)
#     python tools/demo.py A|B|C     로봇견마다 (A = teleop, B·C = marker_follow)
# 없는 개·카메라는 비워 둔다. 카메라는 IP 만 쓰면 http://<IP>:81/stream, 다른 주소면 http:// 부터 전부.

# 허브를 돌리는 컴퓨터 (Mac 또는 Pi). 같은 컴퓨터에서 A·B·C 를 켜도 이 IP 를 그대로 쓰면 됨
HUB=192.168.0.11
HUB_PORT=8000

# 로봇견 (Thonny 에서 dog_cmd.py 를 Run 하면 나오는 IP)
DOG_A=
DOG_B=192.168.0.18
DOG_C=

# 로봇견 카메라 (ESP32-CAM)
CAM_A=
CAM_B=192.168.0.17
CAM_C=

# 프로그램마다 늘 붙이는 옵션 (선택). 실행할 때 뒤에 더 붙이면 그게 우선
OPTS_HUB=
OPTS_A=
OPTS_B=--max-speed 80
OPTS_C=--max-speed 80
